config_version=5

[application]
config/name="Scarlet Witch: Chaos Reborn"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]
EventBus="*res://scripts/managers/event_bus.gd"
GameState="*res://scripts/managers/game_state.gd"
InputConfig="*res://scripts/managers/input_config.gd"
FeelDirector="*res://scripts/managers/feel_director.gd"
SceneManager="*res://scripts/managers/scene_manager.gd"
Game="*res://scripts/managers/game.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[rendering]
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
